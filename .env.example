# Copy to .env locally. Never commit credentials.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash
ALLOWED_HOSTS=localhost,127.0.0.1,testserver


# Pilot access: private (browser sign-in) or public.
ACCESS_MODE=private
APP_ENV=development
PILOT_USERNAME=pilot
PILOT_PASSWORD=replace_with_at_least_20_characters

# Production telemetry (Render PostgreSQL internal URL).
DATABASE_URL=
SESSION_HASH_SALT=replace_with_a_long_random_value
PROMPT_VERSION=translation-v1

# Separate developer dashboard at /admin.
ADMIN_USERNAME=developer
ADMIN_PASSWORD=replace_with_at_least_20_characters

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required only when users opt in to store encrypted text examples.
FEEDBACK_ENCRYPTION_KEY=
